# Configurações do npm para este projeto.

# Segurança: só instala versões publicadas há pelo menos 7 dias.
# Quando um pacote é invadido, isso costuma ser descoberto e corrigido nos primeiros dias.
min-release-age=7

# Recusa instalar com uma versão do Node diferente da combinada (veja .nvmrc e "engines").
engine-strict=true
