# Modelo de configuração local. Copie para ".env.local" e preencha só o que precisar mudar.
# Se uma variável ficar vazia, o app usa o endereço padrão (veja docs/fontes-de-dados.md).
#
# ATENÇÃO: tudo que começa com VITE_ vai parar no navegador e QUALQUER PESSOA pode ver.
# Nunca coloque senha, token ou chave numa variável VITE_.

# Servidor de rotas a pé (padrão: Valhalla da FOSSGIS, para desenvolvimento e piloto pequeno)
VITE_URL_VALHALLA=

# Busca com autocompletar (padrão: Photon da komoot)
VITE_URL_PHOTON=

# Busca de reserva, sem autocompletar (padrão: Nominatim da OSMF)
VITE_URL_NOMINATIM=

# Estilo do mapa (padrão: estilo claro "liberty" do OpenFreeMap; o escuro é .../styles/dark)
VITE_URL_ESTILO_MAPA=

# --- Fase 2 em diante: segredos que só podem existir numa função de servidor (NUNCA com VITE_) ---
# FOGO_CRUZADO_EMAIL=
# FOGO_CRUZADO_SENHA=
# OPENROUTESERVICE_CHAVE=
